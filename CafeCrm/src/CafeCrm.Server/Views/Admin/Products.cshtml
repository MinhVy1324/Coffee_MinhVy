@model ProductDto[]
@{ ViewData["Title"] = "Danh mục sản phẩm"; var query = Context.Request.Query; }
<div class="page-heading"><div><span class="eyebrow">DANH MỤC QUÁN</span><h1>Danh mục sản phẩm</h1><p class="subtitle">Quản lý những hương vị làm nên trải nghiệm của khách hàng.</p></div><a class="button" href="/Admin/ProductEditor"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#plus" /></svg>Thêm sản phẩm</a></div>
<form method="get" class="card toolbar" action="/Admin/Products">
    <label for="product-search">Tên sản phẩm<input id="product-search" name="search" value="@query["search"]" placeholder="Tìm tên sản phẩm..."></label>
    <label for="product-category">Nhóm sản phẩm<select id="product-category" name="categoryId"><option value="">Tất cả nhóm</option>@foreach (var c in (List<Category>)ViewBag.Categories) { <option value="@c.Id" selected="@(query["categoryId"] == c.Id.ToString())">@c.Name</option> }</select></label>
    <label for="product-supplier">Nhà cung cấp<select id="product-supplier" name="supplierId"><option value="">Tất cả nhà cung cấp</option>@foreach (var s in (List<Supplier>)ViewBag.Suppliers) { <option value="@s.Id" selected="@(query["supplierId"] == s.Id.ToString())">@s.Name</option> }</select></label>
    <label for="product-min">Giá từ (đ)<input id="product-min" name="minPrice" value="@query["minPrice"]" placeholder="0" type="number" min="0"></label>
    <label for="product-max">Giá đến (đ)<input id="product-max" name="maxPrice" value="@query["maxPrice"]" placeholder="Không giới hạn" type="number" min="0"></label>
    <label for="product-active">Trạng thái<select id="product-active" name="active"><option value="">Tất cả trạng thái</option><option value="true" selected="@(query["active"] == "true")">Đang phục vụ</option><option value="false" selected="@(query["active"] == "false")">Ngừng phục vụ</option></select></label>
    <label for="product-sort">Sắp xếp<select id="product-sort" name="sort"><option value="name" selected="@(query["sort"] == "name")">Tên sản phẩm</option><option value="price" selected="@(query["sort"] == "price")">Giá tăng dần</option><option value="price_desc" selected="@(query["sort"] == "price_desc")">Giá giảm dần</option></select></label>
    <button type="submit"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#filter" /></svg>Lọc</button><a class="button ghost" href="/Admin/Products">Đặt lại</a>
</form>
<section class="card table-card"><div class="card-heading"><h2>Danh sách sản phẩm</h2><span class="count-badge">@Model.Length sản phẩm</span></div>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Danh sách sản phẩm"><table><thead><tr><th scope="col">Sản phẩm</th><th scope="col">Nhóm</th><th scope="col">Nhà cung cấp</th><th scope="col">Giá bán</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead><tbody>
    @foreach (var p in Model) { <tr><td><strong>@p.Name</strong></td><td>@p.Category</td><td>@(p.Supplier ?? "Chưa chỉ định")</td><td class="price-cell">@p.Price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ</td><td><span class="badge @(p.IsActive ? "" : "badge-disabled")">@(p.IsActive ? "Đang phục vụ" : "Ngừng phục vụ")</span></td><td><a class="table-action" href="/Admin/ProductEditor/@p.Id" aria-label="Sửa sản phẩm @p.Name">Chỉnh sửa</a></td></tr> }
    </tbody></table></div>
    @if (Model.Length == 0) { <div class="empty"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#cup" /></svg><h3>Chưa có sản phẩm phù hợp</h3><p>Điều chỉnh bộ lọc hoặc thêm sản phẩm mới vào danh mục.</p><a href="/Admin/Products">Xóa bộ lọc</a></div> }
    <div class="table-footer">@Model.Length sản phẩm trong danh sách hiện tại</div>
</section>
