@model FeedbackDto[]
@{ ViewData["Title"] = "Phản hồi của tôi"; var rating = (int?)ViewBag.FeedbackRating ?? 5; var productId = (int?)ViewBag.FeedbackProduct; }
<div class="page-heading"><div><span class="eyebrow">CẢM ƠN BẠN ĐÃ GHÉ QUÁN</span><h1>Chia sẻ trải nghiệm của bạn</h1><p class="subtitle">Một lời góp ý nhỏ giúp quán chăm sóc bạn tốt hơn.</p></div></div>
<div class="content-split feedback-compose">
    <form method="post" action="/Portal/Feedback" class="card form-card" data-prevent-double-submit>@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-summary" role="alert"></div><h2>Gửi phản hồi mới</h2>
        <label for="feedback-product">Bạn muốn góp ý về</label><select id="feedback-product" name="productId"><option value="">Dịch vụ chung của quán</option>@foreach (var p in (List<Product>)ViewBag.Products) { <option value="@p.Id" selected="@(productId == p.Id)">@p.Name</option> }</select>
        <fieldset class="rating-fieldset"><legend>Trải nghiệm của bạn</legend><div class="rating-options">@for (var i = 1; i <= 5; i++) { <label class="rating-option"><input type="radio" name="rating" value="@i" checked="@(rating == i)" required><span><b aria-hidden="true">★</b>@i</span></label> }</div><p class="form-hint">1: Chưa hài lòng · 5: Rất hài lòng</p></fieldset>
        <label for="feedback-content">Điều bạn muốn chia sẻ</label><textarea id="feedback-content" name="content" placeholder="Bạn thích điều gì? Quán có thể cải thiện điều gì?" required maxlength="2000" aria-describedby="feedback-counter" data-character-count="feedback-counter">@ViewBag.FeedbackContent</textarea><p class="form-hint" id="feedback-counter">Tối đa 2.000 ký tự.</p><button type="submit"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#message" /></svg>Gửi phản hồi</button>
    </form>
    <aside class="info-panel"><span class="section-icon"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#message" /></svg></span><h2>Quán luôn lắng nghe.</h2><p>Đội ngũ sẽ tiếp nhận góp ý của bạn. Khi có câu trả lời, bạn có thể xem trong lịch sử phản hồi bên dưới.</p><p>Cảm ơn bạn đã cùng quán tạo nên những trải nghiệm tốt hơn.</p></aside>
</div>
<h2 class="section-title">Những điều bạn đã chia sẻ <span class="count-badge">@Model.Length phản hồi</span></h2>
<form action="/Portal/Feedback" method="get" class="portal-filter"><label for="feedback-status">Trạng thái</label><select id="feedback-status" name="status"><option value="">Tất cả</option>@foreach (var value in Enum.GetValues<FeedbackStatus>()) { <option value="@value" selected="@((FeedbackStatus?)ViewBag.FeedbackStatus == value)">@CrmLabels.Feedback(value)</option> }</select><button type="submit" class="ghost">Lọc phản hồi</button></form>
@foreach (var f in Model) { <article class="card feedback-item"><div class="item-heading"><div><h2>@(f.ProductName ?? "Dịch vụ của quán")</h2><p class="form-hint">@f.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm") · @f.Rating / 5 điểm</p></div><span class="badge status-@f.Status.ToString().ToLowerInvariant()">@CrmLabels.Feedback(f.Status)</span></div><partial name="_FeedbackThread" model="f" /></article> }
@if (Model.Length == 0) { <div class="card empty"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#leaf" /></svg><h3>@(ViewBag.FeedbackStatus == null ? "Chưa có phản hồi nào" : "Không có phản hồi ở trạng thái này")</h3><p>Gửi góp ý mới hoặc chọn trạng thái khác để xem lịch sử của bạn.</p></div> }
