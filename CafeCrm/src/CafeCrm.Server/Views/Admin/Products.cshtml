@model ProductDto[]
<h1>Danh mục sản phẩm</h1><p class="subtitle">Tra cứu sản phẩm phục vụ phản hồi và khảo sát.</p>
<form method="get" class="toolbar"><label>Tên<input name="search" placeholder="Tên sản phẩm"></label><label>Nhóm<select name="categoryId"><option value="">Tất cả</option>@foreach(var c in (List<Category>)ViewBag.Categories){<option value="@c.Id">@c.Name</option>}</select></label><label>Nhà cung cấp<select name="supplierId"><option value="">Tất cả</option>@foreach(var s in (List<Supplier>)ViewBag.Suppliers){<option value="@s.Id">@s.Name</option>}</select></label><label>Giá từ<input name="minPrice" type="number" min="0"></label><label>Giá đến<input name="maxPrice" type="number" min="0"></label><label>Trạng thái<select name="active"><option value="">Tất cả</option><option value="true">Đang phục vụ</option><option value="false">Ngừng phục vụ</option></select></label><label>Sắp xếp<select name="sort"><option value="name">Tên</option><option value="price">Giá tăng</option><option value="price_desc">Giá giảm</option></select></label><button>Lọc</button></form>
<a class="button" href="/Admin/ProductEditor">Thêm sản phẩm</a><div class="card"><table><tr><th>Tên</th><th>Nhóm</th><th>Nhà cung cấp</th><th>Giá</th><th>Trạng thái</th><th></th></tr>
@foreach(var p in Model){<tr><td>@p.Name</td><td>@p.Category</td><td>@p.Supplier</td><td>@p.Price.ToString("N0") đ</td><td>@(p.IsActive ? "Đang phục vụ" : "Ngừng phục vụ")</td><td><a href="/Admin/ProductEditor/@p.Id">Sửa</a></td></tr>}</table></div>
