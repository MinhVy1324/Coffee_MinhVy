@model SurveyDto[]
@{ ViewData["Title"] = "Khảo sát khách hàng"; }
<div class="page-heading"><div><span class="eyebrow">CÙNG KHÁCH HÀNG ĐỊNH HÌNH TRẢI NGHIỆM</span><h1>Khảo sát khách hàng</h1><p class="subtitle">Soạn câu hỏi, gửi đến tài khoản khách và theo dõi kết quả.</p></div><a class="button" href="/Crm/CreateSurvey"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#plus" /></svg>Tạo khảo sát</a></div>
<div class="grid metric"><div class="card stat-card"><span class="stat-label">Bản nháp</span><strong>@Model.Count(x => x.Status == SurveyStatus.Draft)</strong><small>Có thể chỉnh sửa câu hỏi</small></div><div class="card stat-card"><span class="stat-label">Đang nhận câu trả lời</span><strong>@Model.Count(x => x.Status == SurveyStatus.Published && x.ClosesAtUtc > DateTime.UtcNow)</strong><small>Khảo sát đã gửi và còn hạn</small></div><div class="card stat-card"><span class="stat-label">Đã đóng / hết hạn</span><strong>@Model.Count(x => x.Status == SurveyStatus.Closed || (x.Status == SurveyStatus.Published && x.ClosesAtUtc <= DateTime.UtcNow))</strong><small>Lưu kết quả để xem lại</small></div></div>
<div class="workflow-note"><span><b>1</b> Soạn bản nháp</span><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#arrow-right" /></svg><span><b>2</b> Chọn khách và gửi</span><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#arrow-right" /></svg><span><b>3</b> Theo dõi kết quả</span></div>
@foreach (var s in Model)
{
    var expired = s.ClosesAtUtc <= DateTime.UtcNow;
    <article class="card survey-item"><div class="item-heading"><div><span class="eyebrow">@s.Questions.Length CÂU HỎI</span><h2>@s.Title</h2></div><span class="badge @(s.Status == SurveyStatus.Draft ? "status-new" : s.Status == SurveyStatus.Closed || expired ? "badge-disabled" : "")">@(expired && s.Status != SurveyStatus.Closed ? "Hết hạn" : CrmLabels.Survey(s.Status))</span></div><p class="text-content muted">@s.Description</p><p class="survey-deadline"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#calendar" /></svg>Hạn trả lời: @s.ClosesAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm") (giờ Việt Nam)</p><div class="survey-actions">
        @if (s.Status == SurveyStatus.Draft) { <a class="button ghost" href="/Crm/EditSurvey/@s.Id">Sửa bản nháp</a><form class="inline" action="/Crm/DeleteSurvey" method="post" data-confirm="Xóa bản nháp khảo sát này?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@s.Id"><input type="hidden" name="version" value="@s.ConcurrencyToken"><button type="submit" class="danger">Xóa bản nháp</button></form> }
        @if (s.Status != SurveyStatus.Closed && !expired) { <a class="button" href="/Crm/PublishSurvey/@s.Id"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#clipboard" /></svg>@(s.Status == SurveyStatus.Draft ? "Gửi khảo sát" : "Gửi thêm khách")</a> }
        @if (s.Status == SurveyStatus.Published) { <form class="inline" action="/Crm/CloseSurvey" method="post" data-confirm="Đóng khảo sát? Khách hàng sẽ không thể gửi thêm câu trả lời.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@s.Id"><input type="hidden" name="version" value="@s.ConcurrencyToken"><button type="submit" class="ghost">Đóng khảo sát</button></form> }
        <a class="button ghost" href="/Crm/Results/@s.Id"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#chart" /></svg>Xem kết quả</a>
    </div></article>
}
@if (Model.Length == 0) { <div class="card empty"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#clipboard" /></svg><h3>Lắng nghe từ khảo sát đầu tiên</h3><p>Tạo câu hỏi về món yêu thích hoặc trải nghiệm tại quán.</p><a class="button" href="/Crm/CreateSurvey">Tạo khảo sát mới</a></div> }
