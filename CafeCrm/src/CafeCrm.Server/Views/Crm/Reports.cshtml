@model ReportDto
<h1>Báo cáo khách hàng</h1><p class="subtitle">Cơ cấu khách hoạt động tại thời điểm xem báo cáo; phản hồi và khảo sát tính trên toàn bộ lịch sử.</p>
<div class="grid metric"><div class="card">Khách hoạt động<strong>@Model.ActiveCustomers</strong></div><div class="card">Tài khoản khóa<strong>@Model.DisabledCustomers</strong></div><div class="card">Hài lòng trung bình<strong>@(Model.AverageFeedbackRating?.ToString("0.00") ?? "Chưa có")</strong></div></div>
<div class="card"><h2>Cơ cấu độ tuổi</h2><table><tr><th>Nhóm tuổi</th><th>Số khách</th><th>Tỷ lệ</th></tr>@foreach(var g in Model.AgeGroups){<tr><td>@g.Group</td><td>@g.Count</td><td>@g.Percentage%</td></tr>}</table></div>
<div class="card"><h2>Sở thích</h2><table><tr><th>Sở thích</th><th>Số khách</th></tr>@foreach(var p in Model.Preferences){<tr><td>@p.Name</td><td>@p.Count</td></tr>}</table><p class="muted">Một khách có thể chọn nhiều sở thích nên tổng số lượt có thể lớn hơn số khách.</p></div>
