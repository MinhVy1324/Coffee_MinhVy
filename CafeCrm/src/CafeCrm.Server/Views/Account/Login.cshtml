@model LoginInput
@{ ViewData["Title"] = "Đăng nhập"; }
<span class="auth-heading-icon"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#cup" /></svg></span>
<span class="eyebrow">CHÀO MỪNG ĐẾN CAFE CRM</span>
<h1>Rất vui được gặp lại bạn.</h1><p class="subtitle">Đăng nhập để tiếp tục chăm sóc những kết nối của bạn.</p>
<form method="post" action="/Account/Login">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl">
    <label for="login-email">Địa chỉ email</label><input id="login-email" name="email" type="email" value="@Model.Email" placeholder="ban@example.com" autocomplete="username" required maxlength="256">
    <label for="login-password">Mật khẩu</label>
    <div class="password-field"><input id="login-password" name="password" type="password" placeholder="Nhập mật khẩu của bạn" autocomplete="current-password" maxlength="128" required><button type="button" class="icon-button" data-password-toggle="login-password" aria-label="Hiện mật khẩu" aria-pressed="false" hidden><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#eye" /></svg></button></div>
    <button type="submit" class="auth-submit"><span>Đăng nhập</span><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#arrow-right" /></svg></button>
</form>
<p class="auth-switch">Khách hàng mới?<a href="/Account/Register">Tạo tài khoản</a></p>
<p class="auth-security"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#shield" /></svg>Không gian riêng, dành cho từng vai trò.</p>
