@model ChangePasswordInput
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<div class="page-heading"><div><span class="eyebrow">CHĂM SÓC TÀI KHOẢN CỦA BẠN</span><h1>Đổi mật khẩu</h1><p class="subtitle">Xác nhận mật khẩu hiện tại để chọn một mật khẩu mới.</p></div><a class="button ghost" href="/Portal/Profile">Về hồ sơ</a></div>
<div class="content-split">
    <form method="post" action="/Portal/ChangePassword" class="card form-card">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-summary" role="alert"></div><h2>Bảo mật tài khoản</h2>
        <label for="password-current">Mật khẩu hiện tại</label><div class="password-field"><input id="password-current" name="CurrentPassword" type="password" autocomplete="current-password" maxlength="128" required><button type="button" class="icon-button" data-password-toggle="password-current" aria-label="Hiện mật khẩu" aria-pressed="false" hidden><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#eye" /></svg></button></div>
        <label for="password-new">Mật khẩu mới</label><div class="password-field"><input id="password-new" name="NewPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" aria-describedby="password-hint" required><button type="button" class="icon-button" data-password-toggle="password-new" aria-label="Hiện mật khẩu" aria-pressed="false" hidden><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#eye" /></svg></button></div>
        <p class="form-hint" id="password-hint">8–128 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt. Mật khẩu mới phải khác mật khẩu hiện tại.</p>
        <label for="password-confirm">Nhập lại mật khẩu mới</label><div class="password-field"><input id="password-confirm" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" data-match-password="password-new" required><button type="button" class="icon-button" data-password-toggle="password-confirm" aria-label="Hiện mật khẩu" aria-pressed="false" hidden><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#eye" /></svg></button></div>
        <div class="form-actions"><button type="submit"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#shield" /></svg>Lưu mật khẩu mới</button></div>
    </form>
    <aside class="info-panel"><span class="section-icon"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#shield" /></svg></span><h2>An tâm mỗi lần ghé.</h2><p>Sau khi đổi, bạn tiếp tục sử dụng phiên hiện tại. Các thiết bị khác cần đăng nhập lại bằng mật khẩu mới.</p><p>Chọn mật khẩu riêng cho tài khoản này và tránh chia sẻ cho người khác.</p></aside>
</div>
