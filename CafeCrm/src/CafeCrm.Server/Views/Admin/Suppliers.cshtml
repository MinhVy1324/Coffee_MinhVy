@model Supplier[]
<h1>Nhà cung cấp</h1><form method="get" class="toolbar"><input name="search" placeholder="Tên, email hoặc số điện thoại"><select name="active"><option value="">Tất cả trạng thái</option><option value="true">Đang hợp tác</option><option value="false">Ngừng hợp tác</option></select><select name="sort"><option value="name">Tên tăng dần</option><option value="name_desc">Tên giảm dần</option></select><button>Tìm và lọc</button><a class="button ghost" href="/Admin/SupplierEditor">Thêm nhà cung cấp</a></form>
<div class="card"><table><tr><th>Tên</th><th>Liên hệ</th><th>Trạng thái</th><th></th></tr>@foreach(var s in Model){<tr><td>@s.Name</td><td>@s.Phone<small>@s.Email</small></td><td>@(s.IsActive ? "Đang hợp tác" : "Ngừng hợp tác")</td><td><a href="/Admin/SupplierEditor/@s.Id">Sửa</a></td></tr>}</table></div>
