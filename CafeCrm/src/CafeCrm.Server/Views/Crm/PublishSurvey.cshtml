@model SurveyPublishViewModel
@{ ViewData["Title"] = "Gửi khảo sát"; }
<div class="page-heading"><div><span class="eyebrow">ĐƯA CÂU HỎI ĐẾN ĐÚNG KHÁCH HÀNG</span><h1>Gửi khảo sát</h1><p class="subtitle">Lời mời sẽ xuất hiện trong mục Khảo sát của tài khoản khách hàng.</p></div><a class="button ghost" href="/Crm/Surveys">Về danh sách</a></div>
<div class="content-split">
    <form method="post" action="/Crm/Publish" class="card form-card" id="publish-survey">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Survey.Id"><input type="hidden" name="version" value="@Model.Survey.ConcurrencyToken"><div asp-validation-summary="All" class="validation-summary" role="alert"></div><h2>Chọn người nhận</h2><p class="section-description">Có @Model.Customers.Length khách hàng đang hoạt động có thể nhận khảo sát.</p>
        <fieldset class="audience-options"><legend class="sr-only">Phạm vi gửi khảo sát</legend><label class="choice-tile"><input type="radio" name="audience" value="all" checked="@(Model.Audience != "selected")"><span><strong>Tất cả khách đang hoạt động</strong><small>Tự bỏ qua khách đã được mời trước đó.</small></span></label><label class="choice-tile"><input type="radio" name="audience" value="selected" checked="@(Model.Audience == "selected")"><span><strong>Chọn khách hàng cụ thể</strong><small>Chỉ gửi đến những người bạn chọn bên dưới.</small></span></label></fieldset>
        <section id="recipient-picker"><div class="recipient-toolbar"><label for="recipient-search" class="sr-only">Tìm người nhận</label><input id="recipient-search" type="search" placeholder="Tìm tên hoặc email..." autocomplete="off"><span id="recipient-count" aria-live="polite">@Model.SelectedIds.Length đã chọn</span></div><div class="recipient-list">
            @foreach (var c in Model.Customers) { <label class="recipient-row" data-recipient><input type="checkbox" name="customerIds" value="@c.Id" checked="@Model.SelectedIds.Contains(c.Id)"><span class="avatar" aria-hidden="true">@(c.FullName.Length > 0 ? c.FullName[..1].ToUpperInvariant() : "K")</span><span><strong>@c.FullName</strong><small>@c.Email</small></span></label> }
        </div><p id="recipient-empty" class="form-hint" hidden>Không có khách hàng phù hợp với từ khóa.</p></section>
        @if (Model.Customers.Length == 0) { <p class="notice notice-error">Chưa có khách hàng hoạt động. Thêm hoặc mở khóa khách trước khi gửi.</p> }
        <div class="form-actions"><button type="submit" disabled="@(Model.Customers.Length == 0)"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#clipboard" /></svg>@(Model.Survey.Status == SurveyStatus.Draft ? "Phát hành và gửi khảo sát" : "Gửi thêm lời mời")</button><a class="button ghost" href="/Crm/Surveys">Hủy</a></div>
    </form>
    <aside class="info-panel"><span class="section-icon"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#clipboard" /></svg></span><h2>@Model.Survey.Title</h2><p class="text-content">@Model.Survey.Description</p><p>@Model.Survey.Questions.Length câu hỏi · Hạn trả lời @Model.Survey.ClosesAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p><div class="form-note"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#lock" /></svg><span>Sau khi phát hành, câu hỏi không thể thay đổi. Mỗi khách trả lời một lần.</span></div></aside>
</div>
@section Scripts { <script src="~/js/survey-publish.js" asp-append-version="true" defer></script> }
