@model SurveyEditor
<h1>Soạn khảo sát</h1><p class="subtitle">Câu hỏi chỉ được sửa khi khảo sát còn là bản nháp.</p>
<form method="post" class="card stack">@Html.AntiForgeryToken()<input type="hidden" name="ConcurrencyToken" value="@Model.ConcurrencyToken">
<label>Tiêu đề</label><input name="Title" value="@Model.Title" required maxlength="150"><label>Mô tả</label><textarea name="Description">@Model.Description</textarea>
<label>Hạn trả lời theo giờ Việt Nam</label><input name="ClosesAt" type="datetime-local" value="@Model.ClosesAt.ToString("yyyy-MM-ddTHH:mm")" required>
<div id="questions">@for(var i=0;i<Model.Questions.Count;i++){var q=Model.Questions[i];<div class="question"><h3>Câu @(i+1)</h3><label>Nội dung</label><input name="Questions[@i].Text" value="@q.Text" required maxlength="500"><label>Loại câu hỏi</label><select name="Questions[@i].Kind">@foreach(var kind in Enum.GetValues<QuestionKind>()){<option value="@kind" selected="@(kind == q.Kind)">@kind</option>}</select><label class="check"><input type="checkbox" name="Questions[@i].IsRequired" value="true" checked="@q.IsRequired">Bắt buộc trả lời</label><input type="hidden" name="Questions[@i].IsRequired" value="false"><label>Lựa chọn mỗi dòng một đáp án</label><textarea name="Questions[@i].Options">@q.Options</textarea><p class="muted">Rating dùng thang 1 đến 5. Text nhận góp ý tối đa 2000 ký tự.</p></div>}</div>
<button type="button" class="ghost" id="addQuestion">Thêm câu hỏi</button> <button>Lưu bản nháp</button></form>
@section Scripts {<script>let questionCount=@Model.Questions.Count;document.getElementById('addQuestion').onclick=()=>{if(questionCount>=30)return;const i=questionCount++;document.getElementById('questions').insertAdjacentHTML('beforeend',`<div class="question"><h3>Câu ${i+1}</h3><label>Nội dung</label><input name="Questions[${i}].Text" required maxlength="500"><label>Loại câu hỏi</label><select name="Questions[${i}].Kind"><option>SingleChoice</option><option>MultipleChoice</option><option>Rating</option><option>Text</option></select><label class="check"><input type="checkbox" name="Questions[${i}].IsRequired" value="true" checked>Bắt buộc trả lời</label><input type="hidden" name="Questions[${i}].IsRequired" value="false"><label>Lựa chọn mỗi dòng một đáp án</label><textarea name="Questions[${i}].Options"></textarea></div>`);};</script>}
