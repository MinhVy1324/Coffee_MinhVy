@model UserRow[]
@functions {
    private static string RoleName(string role) => role switch {
        Roles.Admin => "Quản trị viên", Roles.Manager => "Quản lý", Roles.Staff => "Nhân viên", Roles.Customer => "Khách hàng", _ => role
    };
}
@{
    ViewData["Title"] = "Quản trị tài khoản";
    var search = Context.Request.Query["search"].ToString();
    var selectedRole = Context.Request.Query["role"].ToString();
    var status = Context.Request.Query["status"].ToString();
    var filtered = !string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(selectedRole) || !string.IsNullOrWhiteSpace(status);
    var totals = (int[])ViewBag.UserTotals;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var createEmail = TempData["CreateEmail"] as string;
    var createRole = TempData["CreateRole"] as string ?? Roles.Staff;
}
<div class="page-heading">
    <div><span class="eyebrow">QUẢN TRỊ HỆ THỐNG</span><h1>Quản trị tài khoản</h1><p class="subtitle">Quản lý thành viên và phân quyền cho không gian của bạn.</p></div>
    <a class="button" href="#create-account"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#plus" /></svg>Tạo tài khoản</a>
</div>
<div class="grid metric stats-grid" aria-label="Thống kê toàn bộ tài khoản">
    <div class="card stat-card"><span class="stat-label">Tổng tài khoản</span><span class="stat-icon"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#users" /></svg></span><strong>@totals[0]</strong><small>Thành viên trong hệ thống</small></div>
    <div class="card stat-card"><span class="stat-label">Đang hoạt động</span><span class="stat-icon"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#check-circle" /></svg></span><strong>@totals[1]</strong><small>Tài khoản có thể đăng nhập</small></div>
    <div class="card stat-card"><span class="stat-label">Nhân sự</span><span class="stat-icon blue"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#shield" /></svg></span><strong>@totals[2]</strong><small>Quản trị, quản lý và nhân viên</small></div>
    <div class="card stat-card"><span class="stat-label">Đã khóa</span><span class="stat-icon rose"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#lock" /></svg></span><strong>@totals[3]</strong><small>Tạm ngừng quyền truy cập</small></div>
</div>
<div class="admin-workspace">
    <section class="card table-card" aria-labelledby="account-list-title">
        <div class="card-heading"><h2 id="account-list-title">Danh sách tài khoản</h2><span class="count-badge">@Model.Length thành viên</span><span class="muted">Quản lý quyền truy cập</span></div>
        <form class="toolbar filter-toolbar" method="get" action="/Admin" role="search">
            <div class="search-field"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#search" /></svg><input name="search" value="@search" placeholder="Tìm kiếm theo email..." aria-label="Tìm tài khoản theo email"></div>
            <select name="role" aria-label="Lọc theo vai trò"><option value="">Tất cả vai trò</option>@foreach (var role in Roles.All) { <option value="@role" selected="@(role == selectedRole)">@RoleName(role)</option> }</select>
            <select name="status" aria-label="Lọc theo trạng thái"><option value="">Tất cả trạng thái</option><option value="active" selected="@(status == "active")">Hoạt động</option><option value="locked" selected="@(status == "locked")">Đã khóa</option></select>
            <button type="submit" class="ghost"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#filter" /></svg>Lọc</button>
        </form>
        @if (filtered) { <div class="filter-summary"><p>@Model.Length tài khoản phù hợp@(string.IsNullOrWhiteSpace(search) ? "." : $" với “{search}”.")</p><a href="/Admin">Xóa bộ lọc</a></div> }
        <div class="table-scroll" tabindex="0" role="region" aria-label="Danh sách tài khoản, cuộn ngang để xem thao tác">
            <table class="accounts-table"><thead><tr><th scope="col">Thành viên</th><th scope="col">Vai trò</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead><tbody>
            @foreach (var u in Model)
            {
                var isCurrentUser = u.Id == currentUserId;
                <tr>
                    <td><div class="user-cell"><span class="avatar" aria-hidden="true">@(u.Email.Length > 0 ? u.Email[..1].ToUpperInvariant() : "?")</span><div><strong>@u.Email</strong><small>@(isCurrentUser ? "Tài khoản của bạn" : u.Roles.Contains(Roles.Customer) ? "Thành viên khách hàng" : "Thành viên nội bộ")</small></div></div></td>
                    <td>@foreach (var role in u.Roles) { <span class="role-badge @(role == Roles.Admin ? "role-admin" : role == Roles.Manager ? "role-manager" : "")">@RoleName(role)</span> }</td>
                    <td><span class="badge @(u.IsDisabled ? "badge-disabled" : "")">@(u.IsDisabled ? "Đã khóa" : "Hoạt động")</span></td>
                    <td>
                        @if (isCurrentUser) { <span class="current-user">Tài khoản đang dùng</span> }
                        else
                        {
                            <div class="row-actions">
                                <form class="inline" action="/Admin/Lock" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id"><input type="hidden" name="disabled" value="@((!u.IsDisabled).ToString().ToLowerInvariant())"><button type="submit" class="ghost" aria-label="@(u.IsDisabled ? "Mở khóa " : "Khóa ")@u.Email">@(u.IsDisabled ? "Mở khóa" : "Khóa")</button></form>
                                @if (!u.Roles.Contains(Roles.Customer))
                                {
                                    <form class="inline role-editor" action="/Admin/Role" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id"><select name="role" aria-label="Vai trò của @u.Email">@foreach (var role in Roles.All.Where(x => x != Roles.Customer)) { <option value="@role" selected="@u.Roles.Contains(role)">@RoleName(role)</option> }</select><button type="submit" class="ghost" aria-label="Lưu vai trò của @u.Email">Lưu</button></form>
                                }
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody></table>
        </div>
        @if (Model.Length == 0)
        {
            <div class="empty"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#search" /></svg><h3>Chưa tìm thấy tài khoản</h3><p>Thử email khác hoặc xóa bộ lọc để xem tất cả thành viên.</p><a href="/Admin">Xem tất cả tài khoản</a></div>
        }
        <div class="table-footer">Hiển thị @Model.Length trên @totals[0] tài khoản <span class="footer-dot">·</span> Sắp xếp theo email</div>
    </section>
    <form class="card create-account" id="create-account" action="/Admin/CreateUser" method="post">
        @Html.AntiForgeryToken()
        <div class="form-icon"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#user" /></svg></div>
        <h2>Thêm thành viên mới</h2><p class="muted">Cấp tài khoản để bắt đầu kết nối.</p>
        <div class="field"><label for="create-email">Địa chỉ email</label><input id="create-email" name="email" type="email" value="@createEmail" placeholder="thanhvien@example.com" autocomplete="off" required maxlength="256"></div>
        <div class="field"><label for="create-password">Mật khẩu ban đầu</label><div class="password-field"><input id="create-password" name="initialPassword" type="password" placeholder="Nhập mật khẩu" autocomplete="new-password" minlength="8" aria-describedby="create-password-hint" required><button type="button" class="icon-button" data-password-toggle="create-password" aria-label="Hiện mật khẩu" aria-pressed="false" hidden><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#eye" /></svg></button></div><p class="form-hint" id="create-password-hint">Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</p></div>
        <div class="field"><label for="create-role">Vai trò thành viên</label><select id="create-role" name="role">@foreach (var role in Roles.All) { <option value="@role" selected="@(role == createRole)">@RoleName(role)</option> }</select></div>
        <button type="submit"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#plus" /></svg>Tạo tài khoản</button>
        <div class="form-note"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#shield" /></svg><span>Vai trò quyết định quyền truy cập. Tài khoản khách hàng và nhân sự được quản lý riêng.</span></div>
    </form>
</div>
