@model SurveyEditor
@{ ViewData["Title"] = "Soạn khảo sát"; }
<div class="page-heading"><div><span class="eyebrow">MỘT CÂU HỎI, THÊM MỘT THẤU HIỂU</span><h1>Soạn khảo sát</h1><p class="subtitle">Lưu bản nháp để chỉnh sửa. Chọn người nhận và phát hành ở bước tiếp theo.</p></div><a class="button ghost" href="/Crm/Surveys">Về danh sách</a></div>
<form method="post" class="survey-editor-form" id="survey-editor">
    @Html.AntiForgeryToken()<input type="hidden" name="ConcurrencyToken" value="@Model.ConcurrencyToken">
    <section class="card form-card"><div asp-validation-summary="All" class="validation-summary" role="alert"></div><h2>Thông tin khảo sát</h2><label for="survey-title">Tiêu đề</label><input id="survey-title" name="Title" value="@Model.Title" placeholder="Ví dụ: Trải nghiệm của bạn tại quán" required maxlength="150"><label for="survey-description">Lời giới thiệu</label><textarea id="survey-description" name="Description" maxlength="2000" placeholder="Cho khách biết mục đích của khảo sát...">@Model.Description</textarea><label for="survey-deadline">Hạn trả lời (giờ Việt Nam)</label><input id="survey-deadline" name="ClosesAt" type="datetime-local" value="@Model.ClosesAt.ToString("yyyy-MM-ddTHH:mm")" required><p class="form-hint">Khảo sát tự ngừng nhận câu trả lời khi hết hạn.</p></section>
    <section class="card"><div class="item-heading"><h2>Câu hỏi khảo sát</h2><span class="count-badge" id="question-count">@Model.Questions.Count / 30 câu</span></div><p class="section-description">Chọn một đáp án, nhiều đáp án, chấm điểm hoặc góp ý bằng văn bản.</p><div id="questions">
        @for (var i = 0; i < Model.Questions.Count; i++) { <partial name="_SurveyQuestionEditor" model="Model.Questions[i]" view-data="@(new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["QuestionIndex"] = i })" /> }
    </div><button type="button" class="ghost" id="addQuestion" hidden><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#plus" /></svg>Thêm câu hỏi</button><p class="form-hint" id="question-editor-hint" role="status"></p></section>
    <div class="form-actions"><button type="submit">Lưu bản nháp</button><a class="button ghost" href="/Crm/Surveys">Hủy</a></div>
</form>
<template id="question-template"><partial name="_SurveyQuestionEditor" model="new QuestionEditor()" /></template>
@section Scripts { <script src="~/js/survey-editor.js" asp-append-version="true" defer></script> }
