@model Product
<h1>Thông tin sản phẩm</h1><form method="post" class="card stack">@Html.AntiForgeryToken()<label>Tên</label><input name="Name" value="@Model.Name" required maxlength="150"><label>Nhóm</label><select name="CategoryId">@foreach(var c in (List<Category>)ViewBag.Categories){<option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name</option>}</select><label>Nhà cung cấp</label><select name="SupplierId"><option value="">Không chỉ định</option>@foreach(var s in (List<Supplier>)ViewBag.Suppliers){<option value="@s.Id" selected="@(s.Id == Model.SupplierId)">@s.Name</option>}</select><label>Giá VNĐ</label><input name="Price" type="number" step="1000" min="0" value="@Model.Price" required><label class="check"><input name="IsActive" type="checkbox" value="true" checked="@Model.IsActive">Đang phục vụ</label><input name="IsActive" type="hidden" value="false"><button>Lưu sản phẩm</button></form>
